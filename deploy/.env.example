# =====================================================================
# DocSign deploy env — COPY this file to `deploy/.env` and fill secrets.
# NEVER commit deploy/.env (it is git-ignored). Secrets must only live
# here at deploy time — they are NOT baked into the docker images.
# =====================================================================

# Public hostname, e.g. https://smart_lms_dev.com (no trailing slash).
# This exact origin must match what users type in the browser.
HOST_URL=https://dev-smartlms.tnitech.vn/docsign

# Explicit server URLs (override HOST_URL-derived defaults in compose).
# Leave empty to derive from HOST_URL; set explicitly if unsure:
#   SERVER_URL=https://dev-smartlms.tnitech.vn/docsign/api/app
#   PUBLIC_URL=https://dev-smartlms.tnitech.vn/docsign
SERVER_URL=
PUBLIC_URL=

# Pushed image tags (timestamp mm-hh-dd-mm-yyyy of the build)
SERVER_TAG=00-22-22-09-2026
CLIENT_TAG=00-22-22-09-2026
# NOTE: client image tag 30-08-*-* was built with BASENAME=/docsign
# (assets + router + i18n locales work under the /docsign subpath).

# --- App identity (must match between client & server) ---
APP_ID=opensign
appName=TNI DocSign

# --- Master key: generate a fresh 12+ char random string per env! ---
# e.g. openssl rand -base64 12
MASTER_KEY=CHANGE_ME_GENERATE_RANDOM

# --- Mongo (internal service, no public port) ---
MONGODB_URI=mongodb://mongo:27017/OpenSignDB
PARSE_MOUNT=/app
USE_LOCAL=true

# --- Storage: keep USE_LOCAL=true OR fill S3-compatible credentials ---
DO_SPACE=
DO_ENDPOINT=
DO_BASEURL=
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_REGION=

# --- Mail (REQUIRED: OTP is enforced on every signing request) ---
SMTP_ENABLE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_USER_EMAIL=
SMTP_PASS=

# --- Document signing certificate (real PFX goes here, base64, single line) ---
# Generate on the server (self-signed, 5 years). NEVER commit the .key/.pfx:
#   openssl req -x509 -newkey rsa:2048 -keyout docsign.key -out docsign.crt -days 1825 -nodes -subj "/C=VN/O=TNI/CN=DocSign Document Signing"
#   openssl pkcs12 -export -out docsign.pfx -inkey docsign.key -in docsign.crt -passout pass:CHANGE_ME_TOO -name docsign
#   chmod 600 docsign.key docsign.pfx
#   base64 -w0 docsign.pfx   # paste output below (one line, no spaces/newlines)
PFX_BASE64=
PASS_PHRASE=

# --- Keycloak SSO (internal users, public client + PKCE) ---
KEYCLOAK_URL=https://dev-smartlms.tnitech.vn/keycloak
KEYCLOAK_REALM=tni
KEYCLOAK_CLIENT_ID=opensign
# Shared company tenant: objectId of partners_Tenant every SSO user joins
KEYCLOAK_TENANT_ID=
KEYCLOAK_DEFAULT_ROLE=contracts_User
ENFORCE_OTP=true

# --- Frontend runtime (injected into build/env.js at container start) ---
# NOTE: compose does NOT expand ${...} inside env files — set explicit URLs.
# - Standalone (this compose + Caddy at domain root):
#     PUBLIC_URL=https://sign.congty.vn
#     REACT_APP_SERVERURL=https://sign.congty.vn/api/app
#     REACT_APP_BASENAME=   (empty; use a root-built client image)
# - Shared nginx subpath /docsign (use subpath-built client image,
#   e.g. tag 04-17-*-* built with BASENAME=/docsign):
PUBLIC_URL=https://localhost:3001/docsign
REACT_APP_APPID=opensign
REACT_APP_SERVERURL=https://localhost:3001/docsign/api/app
REACT_APP_BASENAME=/docsign
REACT_APP_ENABLE_KEYCLOAK=true
REACT_APP_KEYCLOAK_URL=https://dev-smartlms.tnitech.vn/keycloak
REACT_APP_KEYCLOAK_REALM=tni
REACT_APP_KEYCLOAK_CLIENT_ID=opensign
